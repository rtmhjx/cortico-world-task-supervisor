{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true, "lib": ["ES2023", "DOM"],
    "types": ["node"], "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "noEmit": true
  },
  "include": ["vendor/**/*.ts"],
  "exclude": ["vendor/**/lib/**"]
}
